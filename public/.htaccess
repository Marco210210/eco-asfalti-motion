ErrorDocument 404 /404.html

# Canonical domain; HTTPS may be terminated at Aruba's reverse proxy.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^ecoasfaltisrl\.it$ [NC]
RewriteRule ^ https://www.ecoasfaltisrl.it%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.ecoasfaltisrl\.it$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://www.ecoasfaltisrl.it%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.ecoasfaltisrl.it/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "^(grazie|404)\.html$">
Header set X-Robots-Tag "noindex, follow"
</FilesMatch>
</IfModule>
