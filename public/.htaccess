ErrorDocument 404 /404.html
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Canonical domain; HTTPS may be terminated at Aruba's reverse proxy.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^ecoasfaltisrl\.it$ [NC]
RewriteRule ^ https://www.ecoasfaltisrl.it%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.ecoasfaltisrl\.it$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://www.ecoasfaltisrl.it%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.ecoasfaltisrl.it/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(webp|png|jpg|jpeg|woff2|mp4)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "^(grazie|404)\.html$">
Header set X-Robots-Tag "noindex, follow"
</FilesMatch>
</IfModule>
